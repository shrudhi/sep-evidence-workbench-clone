# Copy to .env and set a server-side provider credential.
MODEL_API_KEY=
MODEL_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
MAPPER_MODEL=
REVIEWER_MODEL=

DATABASE_PATH=/app/data/workbench.db
SOURCE_DIR=/app/sources
ARTIFACT_DIR=/app/data
FRONTEND_DIR=/app/frontend/dist
MODEL_TIMEOUT_SECONDS=180
MAX_RUN_BUDGET_USD=1.50
MAX_ACTIVE_RUNS=1
MAX_TOTAL_RUNS=25
INPUT_COST_PER_MILLION_USD=0.30
OUTPUT_COST_PER_MILLION_USD=2.50
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Email delivery (optional). Without this, analysis/Dashboard/downloads still work.
EMAIL_PROVIDER=none
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
APP_PUBLIC_BASE_URL=http://127.0.0.1:8000
